# コピーして .env.local を作り、値を入れる（.env.local はコミットしない）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 運営者名と問い合わせ先（公開前に必ず入れる）
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Supabase（開発用プロジェクト） ----
# Project URL（Project Settings → Data API）
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key（Project Settings → API Keys。sb_publishable_ で始まる。画面に出してよいキー）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key（Project Settings → API Keys。sb_secret_ で始まる。サーバー側だけで使う。絶対に公開しない）
SUPABASE_SECRET_KEY=
# DBの接続文字列（上の「Connect」→ Session pooler の URI。[YOUR-PASSWORD] をDBのパスワードに置きかえる）
# テーブルを作るとき（npm run db:push）だけ使う
SUPABASE_DB_URL=

# ---- 楽天ウェブサービス（C2） ----
# アプリID と アクセスキー（楽天ウェブサービスの「Your Apps」）
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトID（あれば商品URLがアフィリエイトURLになる）
RAKUTEN_AFFILIATE_ID=
# 楽天のアプリに登録したサイトのURL（空なら NEXT_PUBLIC_SITE_URL を使う）
RAKUTEN_SITE_URL=

# ---- Yahoo!ショッピング（C3） ----
# Client ID（Yahoo!デベロッパーネットワーク）
YAHOO_CLIENT_ID=
# バリューコマースのアフィリエイトID（あれば商品URLがアフィリエイトURLになる）
VALUECOMMERCE_ID=
